# Salin ke .env dan sesuaikan per-environment (dev/staging/prod).
APP_NAME="Manajemen Biaya Bus AKAP"
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=base64:GANTI-DENGAN-KUNCI-ACAK-DI-PRODUKSI
APP_TZ=Asia/Jakarta

# SQLite (default, tanpa server):
DB_DSN=sqlite:storage/app.sqlite
# PostgreSQL (jika tersedia), contoh:
# DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=akap
# DB_USER=akap
# DB_PASS=secret

SESSION_LIFETIME=43200

# Keamanan
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SEC=300
UPLOAD_MAX_BYTES=5242880

# Penyimpanan file (local | s3). S3 memerlukan kredensial tambahan saat produksi.
STORAGE_DRIVER=local
